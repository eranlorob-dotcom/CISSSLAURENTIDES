<h3>Distance entre la population et une plage accessible aux résidents</h3>
<div class="tbl"><table>
  <thead><tr><th class="l">Secteur</th><th>Population 2025</th><th>Moins de 1,2 km</th><th>1,2 à 4 km</th><th>4 à 8 km</th><th>Plus de 8 km</th></tr></thead>
  <tbody class="num">
    <tr><td class="l">Village</td><td>863</td><td>17 %</td><td>83 %</td><td>0 %</td><td>0 %</td></tr>
    <tr><td class="l">Saint-Jovite</td><td>8 127</td><td>0 %</td><td>0 %</td><td>31 %</td><td class="hi">69 %</td></tr>
    <tr><td class="l">Tremblant</td><td>525</td><td>33 %</td><td>65 %</td><td>2 %</td><td>0 %</td></tr>
    <tr><td class="l">Hors périmètre urbain</td><td>2 488</td><td>0 %</td><td>31 %</td><td>23 %</td><td>46 %</td></tr>
    <tr class="tot"><td class="l">Mont-Tremblant</td><td>12 003</td><td>3 %</td><td>15 %</td><td>26 %</td><td>56 %</td></tr>
